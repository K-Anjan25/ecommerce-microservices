# Copy to .env and fill in real values. NEVER commit .env.

POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=root
# Local default is update. Set to validate only after versioned production migrations are applied.
JPA_DDL_AUTO=update
# Disabled locally; enable only after baselining each existing database.
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=0

# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=

# Exact production storefront origin, e.g. https://shop.example.com
CORS_ALLOWED_ORIGIN=http://localhost:3000
STOREFRONT_PUBLIC_URL=http://localhost:3000
CHECKOUT_CAPABILITY_TTL=PT720H
PAYMENT_RECONCILIATION_PENDING_TTL=PT30M
PAYMENT_RECONCILIATION_SCAN_DELAY_MS=60000
PAYMENT_RECONCILIATION_BATCH_SIZE=100
PAYMENT_RECONCILIATION_RESOLVED_RETENTION=P90D
PAYMENT_RECONCILIATION_RETENTION_SCAN_DELAY_MS=21600000
PAYMENT_RECONCILIATION_HEALTH_OPEN_CASE_THRESHOLD=100
GIFT_CARD_PURCHASE_PENDING_TTL=PT30M
GIFT_CARD_PURCHASE_LIFECYCLE_SCAN_DELAY_MS=60000
GIFT_CARD_PURCHASE_LIFECYCLE_BATCH_SIZE=100
APP_FRONTEND_URL=http://localhost:3000
# Generate independently from JWT_SECRET: openssl rand -base64 48
INTERNAL_SERVICE_SECRET=

EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
# Base64-encoded 32-byte key; generate with: openssl rand -base64 32
EMAIL_OUTBOX_ENCRYPTION_KEY=
EMAIL_OUTBOX_PUBLISH_DELAY_MS=30000
EMAIL_OUTBOX_BATCH_SIZE=50
EMAIL_OUTBOX_MAX_ATTEMPTS=20
EMAIL_OUTBOX_DEAD_RETENTION=P30D
EMAIL_OUTBOX_RETENTION_SCAN_DELAY_MS=21600000
EMAIL_OUTBOX_HEALTH_DEAD_THRESHOLD=10

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
