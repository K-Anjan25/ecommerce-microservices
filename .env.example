# Copy to .env and fill in real values. NEVER commit .env.

POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=root

# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=

# Exact production storefront origin, e.g. https://shop.example.com
CORS_ALLOWED_ORIGIN=http://localhost:3000
STOREFRONT_PUBLIC_URL=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
# Generate independently from JWT_SECRET: openssl rand -base64 48
INTERNAL_SERVICE_SECRET=

EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
