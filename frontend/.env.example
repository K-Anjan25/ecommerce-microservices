# Leave empty when the frontend is served by the API gateway proxy.
VITE_API_BASE_URL=

# Public Razorpay key ID only; never put the Razorpay secret here.
# The checkout UI stays in pending mode until this is configured.
VITE_RAZORPAY_KEY_ID=

# Public Stripe publishable key only; never put STRIPE_SECRET_KEY here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Used only when generating production sitemap.xml and robots.txt.
VITE_PUBLIC_STOREFRONT_URL=https://shop.example.com
# Optional comma-separated product slugs/IDs, e.g. /products/sku-1,/products/sku-2
VITE_SITEMAP_PRODUCT_URLS=
